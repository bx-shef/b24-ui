# Сайт документации Bitrix24 UI — настройки сервера. Копия: cp .env.example .env
# install.sh создаёт .env сам и вписывает то, что передано переменными окружения.

# Домен сайта. ПЛЕЙСХОЛДЕР: домен ещё не выбран владельцем (bx-shef/b24-ui#9) — заменить до первого запуска.
# DNS A-запись должна указывать на сервер ДО подъёма, иначе сертификат Let's Encrypt не выпустится.
DOMAIN=docs.example.com

# Почта для уведомлений Let's Encrypt (необязательно)
LETSENCRYPT_EMAIL=

# Тег образа ghcr.io/bx-shef/b24-ui-docs: latest — последний main, sha-<коммит> — закрепить версию
IMAGE_TAG=latest

# Адрес сайта (canonical, sitemap, llms.txt) вшит в образ при сборке, здесь его не поменять:
# домен меняется пересборкой образа (README.md, «Адреса сайта»).

# Чат «Спросить AI» на сайте (DeepSeek). Ключ задаётся ТОЛЬКО здесь, в репозиторий и в образ он не попадает.
# Пусто — чат на сайте скрыт полностью (кнопок нет, маршрут /api/ai отвечает 404, провайдеру запросы не уходят).
# После изменения: make prod-up (контейнер пересоздаётся и читает .env заново).
NUXT_DEEPSEEK_API_KEY=
# Модель: deepseek-chat (по умолчанию) или deepseek-reasoner
NUXT_DEEPSEEK_MODEL=deepseek-chat
