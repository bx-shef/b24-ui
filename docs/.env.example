## Allow overriding allowed hosts via env, e.g., NUXT_ALLOWED_HOSTS="example.com,foo.com"
NUXT_ALLOWED_HOSTS=

NUXT_PUBLIC_SITE_URL=
NUXT_PUBLIC_BASE_URL=
NUXT_PUBLIC_CANONICAL_URL=
NUXT_PUBLIC_GIT_URL=

# Used to fetch GitHub data (commits, releases, pull requests)
NUXT_GITHUB_TOKEN=

# Чат «Спросить AI» (DeepSeek, https://platform.deepseek.com/api_keys). Только сервер: ключ клиенту не отдаётся.
# Пусто — чата на сайте нет (кнопка скрыта, POST /api/ai отвечает 404).
NUXT_DEEPSEEK_API_KEY=
# deepseek-chat (по умолчанию) | deepseek-reasoner
NUXT_DEEPSEEK_MODEL=deepseek-chat
# Адрес API, нужен только чтобы направить чат на заглушку в проверках
# NUXT_DEEPSEEK_BASE_URL=https://api.deepseek.com

# Счётчик Яндекс Метрики: только цифры, пусто — без счётчика (локально и в тестах оставляем пустым).
NUXT_PUBLIC_YANDEX_METRIKA_ID=
